# ---------------------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in your own values.
# Never share your ".env" file with anyone - it contains secrets.
# ---------------------------------------------------------------------------

# ---- Discord ---------------------------------------------------------------

# Your bot's token: https://discord.com/developers/applications
# -> your application -> Bot -> Reset Token -> Copy
DISCORD_TOKEN=

# Your server (guild) ID: enable Developer Mode in Discord
# (User Settings -> Advanced), then right-click your server icon
# -> Copy Server ID.
SERVER_ID=

# Optional: the channel that receives the daily digest at 12:00 PM Eastern.
# Right-click a channel -> Copy Channel ID. Leave blank to turn the daily
# message off.
ALERT_CHANNEL_ID=

# ---- Canvas ----------------------------------------------------------------

# Canvas -> Account -> Settings -> "+ New Access Token" -> copy the token
# (Canvas only shows it once).
CANVAS_TOKEN=

# Your school's Canvas address, without "/api/v1" at the end. Defaults to UNF.
# Uncomment and change it if your school is not UNF:
#CANVAS_BASE_URL=https://canvas.unf.edu

# Optional: only show courses whose name contains this term code.
# Leave blank to auto-detect (UNF: Fall 2026 = 202680, Spring 2026 = 202610,
# Summer 2026 = 202650).
#CANVAS_TERM=
